import matplotlib.pyplot as plt
import numpy as np

data = {
    "x": np.linspace(-10, 10, 100),  # 100 точек от -10 до 10
    "y": np.sin(np.linspace(-10, 10, 100)) 
}

settings = {
    "title": "Автономный график синуса",
    "xlabel": "Ось X",
    "ylabel": "Ось Y",
    "xmin": -5,  
    "xmax": 5,  
    "grid": True
}

plt.figure(figsize=(10, 5))
plt.plot(data["x"], data["y"], 'b-', linewidth=2)

plt.title(settings["title"])
plt.xlabel(settings["xlabel"])
plt.ylabel(settings["ylabel"])
if settings["grid"]:
    plt.grid(True, linestyle='--', alpha=0.7)

plt.xlim(settings["xmin"], settings["xmax"])

x_range_info = f"Полный интервал X: [-10.0, 10.0]\nОтображаемый интервал: [{settings['xmin']}, {settings['xmax']}]"
plt.text(0.5, -0.15, x_range_info, ha='center', va='center',
         transform=plt.gca().transAxes, fontsize=10)

plt.tight_layout()
plt.show()
