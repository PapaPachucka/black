import sys
import json
import matplotlib.pyplot as plt


def main():
    filename = ""
    title_text = ''
    args = sys.argv[1:]
    i = 0
    while i < len(args):
        if args[i] == "--head" and i + 1 < len(args):
            title_text = args[i + 1]
            i += 1
        else:
            filename = args[i]
        i += 1

    if not filename:
        filename = input("Введите путь до файла JSON: ")

    try:
        with open(filename, 'r') as file:
            data = json.load(file)

        points = data['data']
        x = [point['x'] for point in points]
        y = [point['y'] for point in points]

        plt.figure(figsize=(10, 6))
        plt.plot(x, y)
        plt.title(title_text)
        plt.xlabel('X')
        plt.ylabel('Y')

        plt.grid(True)
        plt.show()
